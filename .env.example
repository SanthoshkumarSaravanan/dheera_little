# Copy to .env and edit. Never commit .env to Git.
POSTGRES_USER=dheera
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=dheera

JWT_SECRET=change_this_to_a_long_random_string
COOKIE_SECURE=false          # set true once the site runs on HTTPS

# First admin (created automatically on first start)
ADMIN_EMAIL=admin@dheeralittles.com
ADMIN_PASSWORD=Admin@12345

# Shipping (all India)
SHIPPING_FLAT=60
FREE_SHIPPING_ABOVE=999

# Email OTP. Leave SMTP_HOST empty in testing: OTPs are printed in backend logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Razorpay (UPI). Leave empty for TEST MODE: payment is simulated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
